{
  "$schema": "https://raw.githubusercontent.com/nicklascschmidt/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "Kerf",
  "version": "0.1.0",
  "identifier": "com.kerf.laser",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kerf",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
