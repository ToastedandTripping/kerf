#!/bin/sh
# Block Zustand selectors that return new objects/arrays (React Error 185).
# This pattern has crashed the app 3 times. See CLAUDE.md for details.

BAD=$(git diff --cached --diff-filter=ACM -- '*.ts' '*.tsx' | grep "^+" | grep -v "^+++" | grep -E "useStore\(\(s\) => \{|useStore\(\(s\) => \(\{|useStore\(\(s\) => s\.[a-zA-Z]+\.(filter|map|reduce|slice)\(")

if [ -n "$BAD" ]; then
  echo ""
  echo "BLOCKED: Zustand selector returns a new object/array (React Error 185 risk)"
  echo ""
  echo "These lines create new references every render, causing infinite re-render loops:"
  echo "$BAD"
  echo ""
  echo "Fix: use separate useStore() calls for each value, or derive arrays outside the selector."
  echo "See CLAUDE.md 'Zustand Selector Rules' for examples."
  echo ""
  exit 1
fi

# Block unformatted source. CI runs Prettier before every Rust step, so one
# unformatted file skips cargo test, clippy and the golden guard on master
# (red 2026-09-11 to 2026-09-22 this way). Checks the working-tree copy of
# each staged file; skips a tool that is not installed rather than blocking.

TS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'src/*.ts' 'src/*.tsx')
if [ -n "$TS_FILES" ]; then
  if [ -x node_modules/.bin/prettier ]; then
    if ! echo "$TS_FILES" | xargs node_modules/.bin/prettier --check --log-level warn; then
      echo ""
      echo "BLOCKED: unformatted TypeScript. Fix: npx prettier --write <files>"
      echo ""
      exit 1
    fi
  else
    echo "pre-commit: prettier not installed (run npm ci); format check skipped"
  fi
fi

RS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'src-tauri/*.rs')
if [ -n "$RS_FILES" ]; then
  if command -v rustfmt >/dev/null 2>&1; then
    if ! echo "$RS_FILES" | xargs rustfmt --check --edition 2021 >/dev/null; then
      echo ""
      echo "BLOCKED: unformatted Rust. Fix: (cd src-tauri && cargo fmt)"
      echo ""
      exit 1
    fi
  else
    echo "pre-commit: rustfmt not on PATH; format check skipped"
  fi
fi
